[Unit]
Description=Kenya crop monitoring FastAPI service
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=kenya_dashboard
Group=kenya_dashboard
WorkingDirectory=/opt/kenya-dashboard/current
EnvironmentFile=/etc/kenya-dashboard.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/kenya-dashboard/venv/bin/uvicorn dashboard.api.app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
